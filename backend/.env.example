# Backend Environment Configuration Example
# Copy to .env and fill in your values

# Application Mode
# ENV=development  # or "production"
# For local development, ENV=development enables in-memory storage

# CORS Configuration (required for production)
# FRONTEND_URL=https://your-vercel-app.vercel.app
# For multiple origins, comma-separated: FRONTEND_URL=https://app1.com,https://app2.com

# AWS Configuration (optional - required for S3/DynamoDB)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Storage (optional)
# S3_BUCKET=your-bucket-name

# DynamoDB (optional)
# DYNAMODB_TABLE=investigations

# Bedrock (optional)
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0